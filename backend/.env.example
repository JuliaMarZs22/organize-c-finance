# Organize-C Finance — Backend
# Copie para .env e preencha. Na Railway, cadastre as mesmas em Variables.

# --- Supabase ---
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOi...   # Supabase → Settings → API → service_role

# --- IA ---
OPENAI_API_KEY=sk-...          # platform.openai.com → API keys
GROQ_API_KEY=gsk_...           # console.groq.com → API Keys

# --- WhatsApp (Meta Cloud API) ---
WHATSAPP_TOKEN=...             # Meta → System User → permanent token
WHATSAPP_PHONE_NUMBER_ID=...   # Meta → WhatsApp → Phone number ID
WHATSAPP_VERIFY_TOKEN=...      # você inventa (usado no handshake do webhook)
GRAPH_VERSION=v21.0            # opcional, padrão v21.0

# --- Google OAuth (para planilha no Drive do cliente) ---
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com   # Google Cloud → Credenciais → OAuth Web
GOOGLE_CLIENT_SECRET=GOCSPX-...                     # Google Cloud → Credenciais → OAuth Web

# --- Digital Manager Guru ---
GURU_TOKEN=...                 # Guru → Integrações → Webhooks → token

# --- URLs ---
PAINEL_URL=https://seu-painel.vercel.app/login   # link enviado no boas-vindas

# --- Portas (cada serviço sobe separado na Railway) ---
PORT=3000   # webhook-whatsapp.js
# PORT=3001 # provisionamento-guru.js  (mude na Railway p/ serviço separado)
# PORT=3002 # drive-backend.js         (idem)

# --- CORS ---
ALLOWED_ORIGIN=https://seu-painel.vercel.app  # domínio do painel Vercel
